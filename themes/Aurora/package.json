{
    "private": true,
    "name": "ctrlpanel-theme-aurora",
    "description": "Aurora theme for CtrlPanel (Tailwind CSS + daisyUI token layer over AdminLTE)",
    "scripts": {
        "build": "npm run build:assets && npm run build:css",
        "build:assets": "node scripts/copy-assets.mjs",
        "build:css": "tailwindcss -i css/app.css -o ../../public/themes/Aurora/app.css --minify",
        "dev": "npm run build:assets && tailwindcss -i css/app.css -o ../../public/themes/Aurora/app.css --watch"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/cli": "^4.3.3",
        "daisyui": "^5.7.47",
        "tailwindcss": "^4.3.3"
    }
}
